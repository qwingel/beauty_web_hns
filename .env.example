# Environment reference only: manage.py does not load dotenv files.
DJANGO_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional public host:port for the Steam connect button on the homepage.
GAME_SERVER_ADDRESS=
# PostgreSQL DSN for the read-only Beauty Bans account.
BEAUTY_BANS_DATABASE_URL=
# PostgreSQL DSN with UPDATE access to Beauty Bans review fields.
BEAUTY_BANS_REVIEW_DATABASE_URL=
AC_MATCH_DATABASE_URL=
AC_MATCH_SERVER_ID=
DATABASE_URL=postgresql://beauty_ac:CHANGE_ME@127.0.0.1:5432/beauty_ac
AC_SERVER_ID=b972127d-7d91-4dcb-8542-723deef81336
AC_SERVER_NAME=Beauty HNS
AC_PRODUCER_TOOLS=D:/projects/beauty-server/tools
AC_SPOOL=D:/ac-queue
AC_OUTPUT=D:/ac-archives
AC_S3_BUCKET=687cfbdb-532d-4bdc-8d35-8c096a8ddfda
AC_S3_ENDPOINT_URL=https://s3.twcstorage.ru
AC_S3_REGION=ru-1
AC_S3_ADDRESSING_STYLE=path

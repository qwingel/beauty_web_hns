[Unit]
Description=Beauty AC archive worker
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=beauty-ac
Group=beauty-ac
EnvironmentFile=/etc/beauty-ac/worker.env
WorkingDirectory=/opt/beauty-ac-web
ExecStart=/opt/beauty-ac-web/.venv/bin/python manage.py process_ac_archives --upload
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/beauty-ac
Environment=PYTHONDONTWRITEBYTECODE=1
Nice=10
CPUWeight=10
CPUQuota=25%
IOSchedulingClass=idle
MemoryMax=384M

[Install]
WantedBy=multi-user.target
